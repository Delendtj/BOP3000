+# pipeline/inference_pipeline.py
+#
+# ANSVAR: Kjøre YOLO-modellen på ferdig-preprosesserte frames (GPU).
+#
+# HVORFOR EGEN TRÅD?
+#   GPU-inference er den tyngste operasjonen i systemet.
+#   Ved å isolere den i en egen tråd unngår vi at den blokkerer
+#   capture, preprocessing eller tracking.
+#
+# INPUT:  proc_q  – FrameItem (ferdig preprosessert frame)
+# OUTPUT: det_q   – DetectionItem (frame + bounding boxes + helmet-numre)
+#
+
+import queue
+import logging
+import threading
+import time
+from dataclasses import dataclass, field
+from typing import Any, List, Optional
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# Datastruktur: DetectionItem
+# ---------------------------------------------------------------------------
+@dataclass
+class Detection:
+    """
+    Én enkelt deteksjon fra YOLO for én utøver.
+
+    bbox:           [x1, y1, x2, y2] i pikselkoordinater
+    confidence:     modellens sikkerhet (0.0 – 1.0)
+    helmet_number:  OCR-lest helmet-nummer (None hvis ikke lesbart)
+    class_id:       YOLO-klasse (f.eks. 0=skater, 1=fall)
+    """
+    bbox: List[float]
+    confidence: float
+    helmet_number: Optional[int] = None
+    class_id: int = 0
+
+
+@dataclass
+class DetectionItem:
+    """
+    "Pakken" som går fra inference → tracking.
+
+    Inneholder den originale frame-infoen + alle deteksjoner fra YOLO.
+    tracking_loop bruker dette til å oppdatere tracker og telle runder.
+    """
+    ts: float
+    frame: Any
+    frame_id: int
+    detections: List[Detection] = field(default_factory=list)
+    inference_ms: float = 0.0   # hvor lang tid inference tok – for profiling
+
+
+# ---------------------------------------------------------------------------
+# Hjelpefunksjoner (fylles ut når modell er klar)
+# ---------------------------------------------------------------------------
+def load_model(config):
+    """
+    Laster YOLO-modellen én gang ved oppstart.
+    Modellen lastes UTENFOR løkken – det ville vært katastrofalt
+    å laste den på nytt for hver frame.
+
+    config.model_path:   sti til .pt / .onnx / OpenVINO-modell
+    config.device:       "cuda", "cpu", eller "openvino"
+    config.conf_thresh:  confidence-terskel (f.eks. 0.5)
+
+    TODO: implementer når modell er klar
+    """
+    logger.info(f"Laster modell fra: {getattr(config, 'model_path', 'N/A')}")
+
+    # Eksempel med Ultralytics YOLO:
+    # from ultralytics import YOLO
+    # model = YOLO(config.model_path)
+    # model.to(config.device)
+    # return model
+
+    return None     # placeholder
+
+
+def run_inference(model, frame, config) -> List[Detection]:
+    """
+    Kjører YOLO på én frame og returnerer liste av Detection.
+
+    TODO: implementer når modell er klar.
+
+    Steg:
+    1. Kjør model(frame) → raw resultater
+    2. Parse bounding boxes, confidence, class
+    3. Kjør OCR på helmet-region for å lese nummer
+    4. Returner liste av Detection
+    """
+    if model is None:
+        return []   # placeholder
+
+    detections = []
+
+    # raw_results = model(frame, conf=config.conf_thresh)
+    # for r in raw_results[0].boxes:
+    #     bbox = r.xyxy[0].tolist()
+    #     conf = float(r.conf)
+    #     cls  = int(r.cls)
+    #     helmet_num = read_helmet_number(frame, bbox)  # OCR
+    #     detections.append(Detection(bbox, conf, helmet_num, cls))
+
+    return detections
+
+
+# ---------------------------------------------------------------------------
+# inference_loop – selve tråd-funksjonen
+
+def inference_loop(in_q, out_q, stop_event: threading.Event, config):
+    """
+    Tråd 3: GPU Inference
+
+    Henter ferdig-preprosesserte frames fra proc_q,
+    kjører YOLO, og sender DetectionItem videre til det_q.
+
+    INFERENCE_EVERY_N_FRAMES (jf. PRD 5.2.4):
+    Vi kjører ikke YOLO på absolutt alle frames – det ville
+    sløst GPU-ressurser. Mellom inference-frames bruker
+    tracking_loop Kalman-prediksjon for å holde sporingen jevn.
+    """
+    # Last modell én gang
+    model = load_model(config)
+    inference_every_n = 1  # frameskip AV: kjør inferens på hver frame # PRD 5.2.4
+    frame_count = 0
+
+    logger.info(f"Inference-tråd klar | inference_every_n={inference_every_n}")
+
+    while not stop_event.is_set():
+        try:
+            item = in_q.get(timeout=0.2)
+        except queue.Empty:
+            continue
+
+        frame_count += 1
+
+        # Hopp over frames mellom inference (Kalman tar over i tracking_loop)
+        if frame_count % inference_every_n != 0:
+            # Send videre uten deteksjoner – tracking bruker prediksjon
+            out_q.put_latest(DetectionItem(
+                ts=item.ts,
+                frame=item.frame,
+                frame_id=item.frame_id,
+                detections=[]       # tom = bruk Kalman-prediksjon
+            ))
+            continue
+
+        # Kjør YOLO her
+        t0 = time.perf_counter()
+        detections = run_inference(model, item.frame, config)
+        inference_ms = (time.perf_counter() - t0) * 1000
+
+        if inference_ms > 100:
+            logger.warning(f"Inference treg: {inference_ms:.1f}ms (frame {item.frame_id})")
+
+        out_q.put_latest(DetectionItem(
+            ts=item.ts,
+            frame=item.frame,
+            frame_id=item.frame_id,
+            detections=detections,
+            inference_ms=inference_ms
+        ))

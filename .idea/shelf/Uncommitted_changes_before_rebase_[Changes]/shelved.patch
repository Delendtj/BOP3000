+# pipeline/tracking_pipeline.py
+#
+# ANSVAR: Multi-object tracking, rundtelling, fall-deteksjon og Re-ID.
+#
+# Dette er den mest komplekse tråden – her skjer all "sport-logikk":
+#   - Oppdatere tracker med nye deteksjoner
+#   - Telle runder når utøver krysser virtuell mållinje
+#   - Detektere fall basert på hastighet + bounding box
+#   - Re-identifisere utøvere som tracker mistet
+#
+# INPUT:  det_q   – DetectionItem (frame + bounding boxes)
+# OUTPUT: event_q – TrackingEvent (runde fullført, fall, Re-ID osv.)
+#
+# VIKTIG: event_q er en vanlig queue.Queue() – events må ALDRI droppes!
+#
+
+import queue
+import logging
+import threading
+import time
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Tuple
+from enum import Enum
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# Event-typer (jf. PRD 5.2.5 Event-Driven Architecture)
+class EventType(Enum):
+    LAP_COMPLETED   = "lap_completed"    # utøver fullførte en runde
+    FALL_DETECTED   = "fall_detected"    # fall detektert
+    RACE_STARTED    = "race_started"     # løpet startet
+    RACE_FINISHED   = "race_finished"    # løpet ferdig
+    SKATER_LAPPED   = "skater_lapped"    # utøver tatt igjen med en runde
+    REID_OCCURRED   = "reid_occurred"    # tracker re-identifiserte en utøver
+
+
+@dataclass
+class TrackingEvent:
+    """
+    Event som sendes til output_pipeline og videre til scoreboard/API.
+
+    event_type:   hva som skjedde (se EventType)
+    skater_id:    hvilken utøver det gjelder (helmet-nummer eller track-ID)
+    ts:           tidspunkt (perf_counter)
+    lap_number:   hvilken runde (hvis relevant)
+    lap_time_ms:  rundetid i millisekunder (hvis relevant)
+    confidence:   hvor sikker systemet er (lav = marker for manuell sjekk)
+    metadata:     ekstra data (posisjon, hastighet osv.)
+    """
+    event_type: EventType
+    skater_id: int
+    ts: float
+    lap_number: int = 0
+    lap_time_ms: float = 0.0
+    confidence: float = 1.0
+    metadata: dict = field(default_factory=dict)
+
+
+# ---------------------------------------------------------------------------
+# SkaterState – holder styr på én utøver
+#
+@dataclass
+class SkaterState:
+    """
+    Alt vi vet om én utøver gjennom løpet.
+
+    track_id:       intern ID fra tracker (byttes ved Re-ID)
+    helmet_number:  kjent helmet-nummer (None hvis ikke lest ennå)
+    lap_count:      antall fullførte runder
+    last_lap_ts:    tidspunkt for siste rundpassering
+    positions:      siste N posisjoner [(x, y, ts), ...]
+    velocities:     estimert hastighet per frame
+    bbox_history:   siste N bounding boxes for fall-deteksjon
+    is_lost:        True hvis tracker mistet denne utøveren
+    frames_lost:    antall frames siden sist sett
+    """
+    track_id: int
+    helmet_number: Optional[int] = None
+    lap_count: int = 0
+    last_lap_ts: float = 0.0
+    positions: List[Tuple] = field(default_factory=list)
+    velocities: List[float] = field(default_factory=list)
+    bbox_history: List[List] = field(default_factory=list)
+    is_lost: bool = False
+    frames_lost: int = 0
+
+    MAX_HISTORY = 30  # antall frames vi husker bakover
+
+    def update_position(self, cx: float, cy: float, ts: float):
+        """Legg til ny posisjon og beregn hastighet."""
+        self.positions.append((cx, cy, ts))
+        if len(self.positions) > self.MAX_HISTORY:
+            self.positions.pop(0)
+
+        # Beregn hastighet (piksler/sekund) hvis vi har minst 2 punkter
+        if len(self.positions) >= 2:
+            prev = self.positions[-2]
+            dx = cx - prev[0]
+            dy = cy - prev[1]
+            dt = ts - prev[2]
+            if dt > 0:
+                speed = ((dx**2 + dy**2) ** 0.5) / dt
+                self.velocities.append(speed)
+                if len(self.velocities) > self.MAX_HISTORY:
+                    self.velocities.pop(0)
+
+    def update_bbox(self, bbox: List[float]):
+        """Lagre bounding box for fall-deteksjon."""
+        self.bbox_history.append(bbox)
+        if len(self.bbox_history) > self.MAX_HISTORY:
+            self.bbox_history.pop(0)
+
+    @property
+    def current_speed(self) -> float:
+        """Siste estimerte hastighet."""
+        return self.velocities[-1] if self.velocities else 0.0
+
+    @property
+    def avg_speed(self) -> float:
+        """Gjennomsnittshastighet siste N frames."""
+        return sum(self.velocities) / len(self.velocities) if self.velocities else 0.0
+
+    @property
+    def current_bbox_aspect(self) -> float:
+        """Aspect ratio (bredde/høyde) for siste bounding box."""
+        if not self.bbox_history:
+            return 1.0
+        b = self.bbox_history[-1]
+        w = b[2] - b[0]
+        h = b[3] - b[1]
+        return w / h if h > 0 else 1.0
+
+
+# ---------------------------------------------------------------------------
+# Hjelpefunksjoner
+def centroid(bbox: List[float]) -> Tuple[float, float]:
+    """Beregn senter-punkt (cx, cy) fra bounding box [x1,y1,x2,y2]."""
+    return ((bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2)
+
+
+def crossed_finish_line(prev_pos, curr_pos, finish_line_x: float,
+                        detection_zone: float = 75.0) -> bool:
+    """
+    Sjekk om utøver krysset den virtuelle mållinjen (jf. PRD 14.5.1).
+
+    Vi bruker en deteksjonssone (±detection_zone piksler) rundt linjen
+    for å ta høyde for tracking-støy.
+
+    finish_line_x:  x-koordinat for mållinjen (konfigureres per bane)
+    detection_zone: halvbredden av deteksjonssonen i piksler
+    """
+    if prev_pos is None or curr_pos is None:
+        return False
+
+    prev_x = prev_pos[0]
+    curr_x = curr_pos[0]
+
+    # bekrefter riktig retning (jf. PRD 5.3.2)
+    moving_right = curr_x > prev_x     # TODO: tilpass per bane-orientering
+
+    # sjekker at vi faktisk krysset linjen
+    crossed = prev_x < finish_line_x <= curr_x
+
+    return crossed and moving_right
+
+
+def detect_fall(skater: SkaterState, config) -> Tuple[bool, float]:
+    """
+    Fall-deteksjon basert på tre indikatorer (jf. PRD 6.1):
+    1. Plutselig hastighetsreduksjon (>70% på 0.5 sek)
+    2. Endring i bounding box aspect ratio (>40%)
+    3. Utøver i ro i >1 sekund
+
+    Returnerer (fall_detektert, konfidens).
+    """
+    if len(skater.velocities) < 10 or len(skater.bbox_history) < 5:
+        return False, 0.0   # ikke nok data
+
+    # --- indikator 1: Hastighetsreduksjon ---
+    recent_speed = skater.velocities[-1]
+    peak_speed = max(skater.velocities[-15:]) if len(skater.velocities) >= 15 else skater.avg_speed
+    speed_drop = (peak_speed - recent_speed) / peak_speed if peak_speed > 0 else 0
+    speed_fallen = speed_drop > 0.70
+
+    # --- indikator 2: Aspect ratio endring ---
+    if len(skater.bbox_history) >= 10:
+        prev_aspect = _aspect_ratio(skater.bbox_history[-10])
+        curr_aspect = skater.current_bbox_aspect
+        aspect_change = abs(curr_aspect - prev_aspect) / prev_aspect if prev_aspect > 0 else 0
+        aspect_fallen = aspect_change > 0.40
+    else:
+        aspect_fallen = False
+
+    # --- indikator 3: Stillstand >1 sekund ---
+    if len(skater.positions) >= 20:
+        recent_positions = skater.positions[-20:]
+        x_range = max(p[0] for p in recent_positions) - min(p[0] for p in recent_positions)
+        y_range = max(p[1] for p in recent_positions) - min(p[1] for p in recent_positions)
+        standing_still = x_range < 15 and y_range < 15
+    else:
+        standing_still = False
+
+    # kombiner indikatorer – krev minst 2 av 3 for å unngå false positives (PRD 6.2)
+    indicators = [speed_fallen, aspect_fallen, standing_still]
+    confirmed = sum(indicators) >= 2
+    confidence = sum(indicators) / 3.0
+
+    return confirmed, confidence
+
+
+def _aspect_ratio(bbox: List[float]) -> float:
+    w = bbox[2] - bbox[0]
+    h = bbox[3] - bbox[1]
+    return w / h if h > 0 else 1.0
+
+
+def attempt_reid(lost_skater: SkaterState, new_detection, known_skaters: Dict) -> bool:
+    """
+    Forsøk Re-ID når tracker mister en utøver (jf. PRD 10.1 Occlusion).
+
+    Prioritert rekkefølge:
+    1. Helmet-nummer match (sterkest – hard constraint)
+    2. Kalman-predikert posisjon vs. ny deteksjon
+    3. Appearance embedding (TODO: implementer med ReID-modell)
+
+    Returnerer True hvis re-identifisert.
+    """
+    # 1. Helmet-nummer match
+    if (lost_skater.helmet_number is not None and
+            new_detection.helmet_number == lost_skater.helmet_number):
+        logger.info(f"Re-ID via helmet-nummer: {lost_skater.helmet_number}")
+        return True
+
+    # 2. Posisjon-basert match (placeholder – Kalman-prediksjon implementeres her)
+    # TODO: sammenlign Kalman-predikert posisjon med ny deteksjon
+
+    # 3. Appearance embedding (placeholder)
+    # TODO: sammenlign feature-vektorer
+
+    return False
+
+
+# ---------------------------------------------------------------------------
+# tracking_loop – selve tråd-funksjonen
+def tracking_loop(in_q, event_q: queue.Queue, stop_event: threading.Event, config):
+    """
+    Tråd 4: Tracking & Logic
+
+    henter detectionItem fra det_q, oppdaterer tracker,
+    teller runder, detekterer fall, håndterer Re-ID.
+
+    Sender TrackingEvent til event_q for hver hendelse.
+    """
+    # Aktive utøvere: track_id → SkaterState
+    active_skaters: Dict[int, SkaterState] = {}
+    # Tapte utøvere (Re-ID buffer): track_id → SkaterState
+    lost_skaters: Dict[int, SkaterState] = {}
+
+    finish_line_x = getattr(config, 'finish_line_x', 640.0)    # konfigurer per bane
+    max_lost_frames = getattr(config, 'max_lost_frames', 150)   # ~5 sek på 30 FPS
+    fall_cooldown_frames = getattr(config, 'fall_cooldown', 90) # 3 sek cooldown
+
+    race_started = False
+    fall_cooldown: Dict[int, int] = {}  # track_id → frames til cooldown utløper
+
+    logger.info("Tracking-tråd klar.")
+
+    while not stop_event.is_set():
+        try:
+            item = in_q.get(timeout=0.2)
+        except queue.Empty:
+            continue
+
+        # --- Oppdater tracker med nye deteksjoner ---
+        # TODO: Erstatt dette med ByteTrack / DeepSORT kall
+        # tracker.update(item.detections) → returnerer liste av (track_id, bbox, helmet_num)
+        tracked_objects = _placeholder_tracker(item.detections)
+
+        current_track_ids = set()
+
+        for track_id, bbox, helmet_number in tracked_objects:
+            current_track_ids.add(track_id)
+            cx, cy = centroid(bbox)
+
+            # Ny utøver – opprett state
+            if track_id not in active_skaters:
+                # Sjekk om dette er en re-identifisert utøver
+                reid_match = None
+                for lost_id, lost_skater in lost_skaters.items():
+                    det_mock = type('D', (), {'helmet_number': helmet_number})()
+                    if attempt_reid(lost_skater, det_mock, active_skaters):
+                        reid_match = lost_skater
+                        del lost_skaters[lost_id]
+                        logger.info(f"Re-ID: track {lost_id} → {track_id}")
+                        event_q.put(TrackingEvent(
+                            event_type=EventType.REID_OCCURRED,
+                            skater_id=helmet_number or track_id,
+                            ts=item.ts,
+                            confidence=0.8,
+                            metadata={"old_track": lost_id, "new_track": track_id}
+                        ))
+                        break
+
+                if reid_match:
+                    reid_match.track_id = track_id
+                    active_skaters[track_id] = reid_match
+                else:
+                    active_skaters[track_id] = SkaterState(
+                        track_id=track_id,
+                        helmet_number=helmet_number
+                    )
+
+            skater = active_skaters[track_id]
+            if helmet_number is not None:
+                skater.helmet_number = helmet_number
+
+            # Hent forrige posisjon
+            prev_pos = skater.positions[-1][:2] if skater.positions else None
+
+            # Oppdater state
+            skater.update_position(cx, cy, item.ts)
+            skater.update_bbox(bbox)
+            skater.is_lost = False
+            skater.frames_lost = 0
+
+            # --- Rundtelling (jf. PRD 5.3) ---
+            if race_started and prev_pos is not None:
+                cooldown_ok = (item.ts - skater.last_lap_ts) > 5.0  # min 5 sek mellom runder
+                if crossed_finish_line(prev_pos, (cx, cy), finish_line_x) and cooldown_ok:
+                    skater.lap_count += 1
+                    lap_time_ms = (item.ts - skater.last_lap_ts) * 1000
+                    skater.last_lap_ts = item.ts
+
+                    logger.info(f"Runde {skater.lap_count} for utøver {skater.helmet_number or track_id}")
+                    event_q.put(TrackingEvent(
+                        event_type=EventType.LAP_COMPLETED,
+                        skater_id=skater.helmet_number or track_id,
+                        ts=item.ts,
+                        lap_number=skater.lap_count,
+                        lap_time_ms=lap_time_ms,
+                        confidence=1.0
+                    ))
+
+            # --- Fall-deteksjon (jf. PRD 6) ---
+            if race_started:
+                cooldown_remaining = fall_cooldown.get(track_id, 0)
+                if cooldown_remaining <= 0:
+                    fall_detected, confidence = detect_fall(skater, config)
+                    if fall_detected:
+                        logger.warning(f"FALL detektert: utøver {skater.helmet_number or track_id} (konfidens={confidence:.2f})")
+                        event_q.put(TrackingEvent(
+                            event_type=EventType.FALL_DETECTED,
+                            skater_id=skater.helmet_number or track_id,
+                            ts=item.ts,
+                            confidence=confidence
+                        ))
+                        fall_cooldown[track_id] = fall_cooldown_frames
+                else:
+                    fall_cooldown[track_id] = cooldown_remaining - 1
+
+        # --- Håndter tapte utøvere (Re-ID buffer) ---
+        for track_id in list(active_skaters.keys()):
+            if track_id not in current_track_ids:
+                skater = active_skaters[track_id]
+                skater.is_lost = True
+                skater.frames_lost += 1
+
+                if skater.frames_lost > max_lost_frames:
+                    logger.info(f"Track {track_id} slettet etter {skater.frames_lost} frames tapt.")
+                    del active_skaters[track_id]
+                else:
+                    # Flytt til lost-buffer for mulig Re-ID
+                    lost_skaters[track_id] = skater
+                    del active_skaters[track_id]
+
+
+def _placeholder_tracker(detections) -> List[Tuple]:
+    """
+    Placeholder til ByteTrack / DeepSORT er integrert.
+    Returnerer liste av (track_id, bbox, helmet_number).
+
+    TODO : å erstatt med ekte tracker til slutt
+    """
+    result = []
+    for i, det in enumerate(detections):
+        result.append((i, det.bbox, det.helmet_number))
+    return result

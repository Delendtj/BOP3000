+# pipeline/output_pipeline.py
+#
+# ANSVAR: Ta imot TrackingEvents og sende dem ut til scoreboard / API / fil.
+#
+# HVORFOR EGEN TRÅD?
+#   Output (JSON, API-kall, fil-skriving) kan blokkere.
+#   Ved å isolere det i en egen tråd påvirker ikke treg nettverksforbindelse
+#   eller disk-I/O tracking-ytelsen.
+#
+# INPUT:  event_q – TrackingEvent (fra tracking_pipeline)
+# OUTPUT: JSON til fil / HTTP API / scoreboard
+#
+# VIKTIG: event_q er vanlig queue.Queue() – events droppes ALDRI.
+#
+
+import json
+import queue
+import logging
+import threading
+import time
+from typing import Dict, List
+
+from pipeline.tracking_pipeline import TrackingEvent, EventType
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# RaceState – holder komplett løp-status for JSON-output
+# ---------------------------------------------------------------------------
+class RaceState:
+    """
+    Holder oversikt over hele løpet.
+    Oppdateres for hver event og serialiseres til JSON.
+
+    Dette er det scoreboard/API mottar.
+    """
+
+    def __init__(self):
+        self.skaters: Dict[int, dict] = {}   # skater_id → status
+        self.race_started = False
+        self.race_start_ts: float = 0.0
+        self.events_log: List[dict] = []
+
+    def apply_event(self, event: TrackingEvent):
+        """Oppdater state basert på event."""
+        skater_id = event.skater_id
+
+        # Opprett utøver hvis ny
+        if skater_id not in self.skaters:
+            self.skaters[skater_id] = {
+                "id": skater_id,
+                "laps": 0,
+                "lap_times_ms": [],
+                "last_lap_time_ms": 0.0,
+                "best_lap_time_ms": None,
+                "status": "racing",     # racing / fell / finished
+                "fell": False,
+            }
+
+        skater = self.skaters[skater_id]
+
+        if event.event_type == EventType.LAP_COMPLETED:
+            skater["laps"] = event.lap_number
+            skater["last_lap_time_ms"] = event.lap_time_ms
+            skater["lap_times_ms"].append(event.lap_time_ms)
+            if skater["best_lap_time_ms"] is None or event.lap_time_ms < skater["best_lap_time_ms"]:
+                skater["best_lap_time_ms"] = event.lap_time_ms
+
+        elif event.event_type == EventType.FALL_DETECTED:
+            skater["fell"] = True
+            skater["status"] = "fell"
+
+        elif event.event_type == EventType.RACE_STARTED:
+            self.race_started = True
+            self.race_start_ts = event.ts
+
+        # Logg event
+        self.events_log.append({
+            "type": event.event_type.value,
+            "skater_id": skater_id,
+            "ts": event.ts,
+            "lap": event.lap_number,
+            "confidence": event.confidence,
+        })
+
+    def to_json(self) -> str:
+        """
+        Serialiser til JSON (jf. PRD 2.1 Score board Integration).
+
+        Format som scoreboard forventer:
+        {
+          "timestamp": 1234567890.123,
+          "race_time_s": 45.2,
+          "skaters": {
+            7: { "id": 7, "laps": 3, "last_lap_time_ms": 12340, ... },
+            ...
+          }
+        }
+        """
+        return json.dumps({
+            "timestamp": time.time(),
+            "race_time_s": (time.perf_counter() - self.race_start_ts) if self.race_started else 0,
+            "skaters": self.skaters,
+        }, indent=2)
+
+
+# ---------------------------------------------------------------------------
+# Output-funksjoner (pluggbare – legg til API-kall her)
+# ---------------------------------------------------------------------------
+def write_to_file(state: RaceState, path: str = "race_state.json"):
+    """
+    Skriv state til JSON-fil.
+    Enkel og pålitelig – bra som primær output under utvikling.
+    """
+    try:
+        with open(path, "w") as f:
+            f.write(state.to_json())
+    except OSError as e:
+        logger.error(f"Kunne ikke skrive til {path}: {e}")
+
+
+def send_to_api(state: RaceState, config):
+    """
+    Send state til eksternt API / scoreboard.
+
+    TODO: implementer HTTP POST når scoreboard-API er klart.
+
+    import requests
+    try:
+        r = requests.post(config.api_url, json=json.loads(state.to_json()), timeout=1.0)
+        if r.status_code != 200:
+            logger.warning(f"API svarte {r.status_code}")
+    except requests.RequestException as e:
+        logger.error(f"API-feil: {e}")
+    """
+    pass    # placeholder
+
+
+# ---------------------------------------------------------------------------
+# output_loop – selve tråd-funksjonen
+
+def output_loop(event_q: queue.Queue, stop_event: threading.Event, config=None):
+    """
+    Tråd 5: Data Output
+
+    Lytter på event_q og oppdaterer RaceState for hvert event.
+    Skriver ut JSON til fil og/eller API etter hvert event.
+
+    Fordi event_q er vanlig queue.Queue() (ikke LatestQueue),
+    er vi garantert å prosessere ALLE events – ingen droppes.
+    """
+    state = RaceState()
+    output_path = getattr(config, 'output_json_path', 'race_state.json') if config else 'race_state.json'
+    last_write_ts = 0.0
+    write_interval = 0.5   # skriv til fil maks hvert 0.5 sekund
+
+    logger.info("Output-tråd klar.")
+
+    while not stop_event.is_set():
+        try:
+            event: TrackingEvent = event_q.get(timeout=0.2)
+        except queue.Empty:
+            continue
+
+        # oppdater state
+        state.apply_event(event)
+        logger.debug(f"Event: {event.event_type.value} | utøver {event.skater_id}")
+
+        # Skriv til fil (ikke for ofte (unngå unødvendig disk-I/O))
+        now = time.perf_counter()
+        if now - last_write_ts > write_interval:
+            write_to_file(state, output_path)
+            last_write_ts = now
+
+        # Send til API
+        if config and getattr(config, 'api_url', None):
+            send_to_api(state, config)
+
+    #siste skriving ved avslutning
+    write_to_file(state, output_path)
+    logger.info(f"Output-tråd ferdig. Siste state skrevet til {output_path}")

+# Uten denne filen ville ikke Python skjønne at mappa er en modul.
+#
+# Her eksporterer vi det som main.py faktisk trenger å importere.
+# Fordel: main.py kan skrive "from pipeline import AsyncFramePipeline"
+# i stedet for "from pipeline.async_pipeline import AsyncFramePipeline"
+#
+
+from pipeline.async_pipeline import AsyncFramePipeline, FrameItem
+from pipeline.inference_pipeline import DetectionItem
+from pipeline.tracking_pipeline import TrackingEvent
+
+__all__ = [
